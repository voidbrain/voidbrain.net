{
  "name": "voidbrain-net",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:backlog": "node tools/check-backlog.mjs",
    "check:freshness": "node tools/check-freshness.mjs",
    "impact-map": "node tools/impact-map.mjs",
    "ci:status": "node tools/ci-status.mjs",
    "code:map": "node tools/code-map.mjs",
    "reconcile:draft": "node tools/reconcile-draft.mjs",
    "check:conventions": "node tools/check-conventions.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\" eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,scss,html}\" eslint.config.mjs",
    "coverage": "ng test --watch=false --coverage --coverage-reporters=json-summary --coverage-include='src/**/*.ts' --coverage-exclude='**/*.spec.ts' && node tools/coverage-table.mjs --write",
    "check:integrations": "node tools/mcp.mjs check",
    "mcp:recommend": "node tools/mcp.mjs recommend",
    "reconcile:preview": "node tools/reconcile-preview.mjs",
    "friction": "node tools/friction.mjs",
    "check:maintenance": "node tools/maintenance.mjs check",
    "check:audits": "node tools/check-audits.mjs",
    "archive:recap": "node tools/archive-recap.mjs",
    "check:archive-recap": "node tools/archive-recap.mjs --check",
    "guard:install": "node tools/guard.mjs install",
    "check:rules": "node tools/check-rules.mjs",
    "check:tooling": "node tools/check-tooling.mjs",
    "behaviour": "node tools/behaviour.mjs",
    "coverage:browser": "node tools/browser-coverage.mjs",
    "check:dependencies": "node tools/backlog-dependencies.mjs --check",
    "check:queue": "node tools/backlog-queue.mjs --check",
    "verification:plan": "node tools/verification.mjs",
    "work:build": "node tools/work-items.mjs build",
    "check:work": "node tools/work-items.mjs check",
    "work:tasks": "node tools/work-items.mjs tasks",
    "work:next": "node tools/work-items.mjs next",
    "work:claims": "node tools/task-claims.mjs",
    "work:usage": "node tools/work-usage.mjs",
    "work:launch": "node tools/usage-launch.mjs",
    "rule-load": "node tools/rule-load.mjs",
    "check:rule-load": "node tools/rule-load.mjs --check"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.1",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true
  }
}
